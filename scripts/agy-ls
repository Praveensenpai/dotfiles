#!/usr/bin/env bash

# agy-ls: Interactive session picker & launcher using fzf

BRAIN_DIR="$HOME/.gemini/antigravity-cli/brain"

# Generate sessions list
SESSIONS=$(
for log in "$BRAIN_DIR"/*/.system_generated/logs/transcript.jsonl; do
    [ -f "$log" ] || continue
    cid=$(basename "$(dirname "$(dirname "$(dirname "$log")")")")
    mtime=$(stat -c %Y "$log")
    prompt=$(jq -r 'select(.type=="USER_INPUT") | .content' "$log" 2>/dev/null | sed -E 's/<[^>]+>//g' | grep -v '^[[:space:]]*$' | head -n 1 | tr '\n' ' ')
    if [ -n "$prompt" ]; then
        dt=$(date -d "@$mtime" "+%Y-%m-%d %H:%M" 2>/dev/null || date -r "$mtime" "+%Y-%m-%d %H:%M")
        echo "$dt │ $cid │ $prompt"
    fi
done | sort -r
)

if [ -z "$SESSIONS" ]; then
    echo "No AGY sessions found."
    exit 0
fi

# Color scheme for fzf (Dracula / Cyberpunk style)
FZF_COLORS="bg+:#282a36,bg:#1e1e2e,spinner:#ff79c6,hl:#bd93f9,fg:#f8f8f2,header:#8be9fd,info:#ffb86c,pointer:#ff79c6,marker:#ff79c6,fg+:#f8f8f2,prompt:#50fa7b,hl+:#ff79c6"

# Run interactive fzf picker
SELECTED=$(echo "$SESSIONS" | fzf \
    --ansi \
    --height 60% \
    --layout=reverse \
    --border=rounded \
    --prompt="🔍 Search Session > " \
    --header="[ ENTER: Resume Session | ESC: Exit ]" \
    --color="$FZF_COLORS" \
    --delimiter="│" \
    --with-nth=1,3)

if [ -z "$SELECTED" ]; then
    echo "Cancelled."
    exit 0
fi

# Extract conversation ID
CID=$(echo "$SELECTED" | awk -F"│" '{print $2}' | tr -d ' ')

if [ -n "$CID" ]; then
    echo -e "\033[38;2;80;250;123m▶ Resuming session:\033[0m \033[38;2;139;233;253m$CID\033[0m"
    exec agy --conversation "$CID"
fi
